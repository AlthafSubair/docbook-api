NODE_ENV=development
PORT=4000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=docbook_app
DB_PASSWORD=replace_with_db_password
DB_NAME=docbook

# CORS & Multi-Tenant Frontend Configuration
FRONTEND_URL=http://localhost:3000
BASE_DOMAIN=docbook.health

# Cookie Configuration
# In production on same root domain (e.g. app.docbook.com & api.docbook.com):
# COOKIE_DOMAIN=.docbook.com
# COOKIE_SAME_SITE=lax
# COOKIE_SECURE=true
# In production on different domains (e.g. vercel.app & onrender.com):
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# OTP Configuration
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_SECRET=replace_with_a_secure_random_string_at_least_16_chars

# JWT Configuration
JWT_ACCESS_SECRET=replace_with_a_secure_jwt_access_secret_min_32_chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=replace_with_a_secure_jwt_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRATION=7d
