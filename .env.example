NODE_ENV=ENV MODE
PORT= APP PORT

DB_HOST=DB IP
DB_PORT=DB PORT
DB_USERNAME=docbook_app
DB_PASSWORD=DB Password
DB_NAME=App Name


# OTP Configuration
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
